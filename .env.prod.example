# ── Production environment variables ──────────
# Copy this file to .env.prod and fill in real values before deploying:
#   cp .env.prod.example .env.prod
#
# IMPORTANT: Never commit .env.prod to version control!
# Generate a strong SECRET_KEY with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"

# ── PostgreSQL ───────────────────────────────
POSTGRES_USER=budget_app
POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
POSTGRES_DB=budget_app

# ── Auth / JWT ───────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_STRING

# ── CORS ─────────────────────────────────────
# JSON array of allowed frontend origins
BACKEND_CORS_ORIGINS=["https://budget.example.com"]

# ── Frontend ─────────────────────────────────
# Port to expose the frontend (nginx) on the host.
# NOTE: bound to 127.0.0.1 only — for local smoke tests. Public traffic
# goes through the Caddy TLS proxy (ports 80/443).
FRONTEND_PORT=3000

# ── TLS (Caddy) ──────────────────────────────
# Public site address. Set this to your domain to enable automatic
# HTTPS (Let's Encrypt) and HTTP→HTTPS redirect, e.g.:
#   SITE_ADDRESS=budget.example.com
# DNS for this domain must point at this server, and ports 80 + 443
# must be reachable from the internet.
# Leave as ":80" only for local testing without TLS — never in prod!
SITE_ADDRESS=:80

# ── Frontend env (baked into the build) ──────
# The URL the browser uses to reach the backend API
VITE_API_URL=https://api.budget.example.com
VITE_API_PREFIX=/api
