# ── Backend environment variables ─────────────
# Copy this file to .env and fill in real values.

# ── App ──────────────────────────────────────
APP_NAME="Budget App API"
APP_VERSION="0.1.0"
DEBUG=true

# ── Database ─────────────────────────────────
# SQLite for local dev (default):
DATABASE_URL="sqlite:///./budget.db"
# PostgreSQL (use with docker-compose):
# DATABASE_URL="postgresql://budget:budget@localhost:5432/budget"

# ── PostgreSQL (used by docker-compose) ──────
POSTGRES_USER=budget
POSTGRES_PASSWORD=budget
POSTGRES_DB=budget

# ── Auth / JWT ───────────────────────────────
# IMPORTANT: change this to a strong random string in production!
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# (The backend refuses to start in production with the default value.)
SECRET_KEY="change-me-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── Rate limiting (optional; defaults shown) ─
# Fixed-window limits per client IP on the auth endpoints.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_REGISTER_MAX=3

# ── Upload limits (optional; defaults shown) ─
# Guards for the Excel import (zip bombs / oversized files).
MAX_UPLOAD_BYTES=5242880        # 5 MB compressed .xlsx
MAX_UNCOMPRESSED_BYTES=52428800 # 50 MB decompressed zip content
MAX_ZIP_ENTRIES=200
MAX_EXCEL_ROWS=10000
MAX_EXCEL_COLUMNS=100

# ── CORS ─────────────────────────────────────
# JSON array of allowed origins — never use "*" in production
# (the backend refuses to start with it when DEBUG=false).
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
