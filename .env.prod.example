# ── Production environment variables ──────────
# Copy this file to .env.prod and fill in real values before deploying:
#   cp .env.prod.example .env.prod
#
# IMPORTANT: Never commit .env.prod to version control!
# Generate a strong SECRET_KEY with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"

# ── PostgreSQL ───────────────────────────────
POSTGRES_USER=budget_app
POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
POSTGRES_DB=budget_app

# ── Auth / JWT ───────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_STRING

# ── CORS ─────────────────────────────────────
# JSON array of allowed frontend origins
BACKEND_CORS_ORIGINS=["https://budget.example.com"]

# ── Frontend ─────────────────────────────────
# Port to expose the frontend (nginx) on the host
FRONTEND_PORT=3000

# ── Frontend env (baked into the build) ──────
# The URL the browser uses to reach the backend API
VITE_API_URL=https://api.budget.example.com
VITE_API_PREFIX=/api
